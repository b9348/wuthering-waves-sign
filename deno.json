{
  "name": "wuthering-waves-sign",
  "version": "1.0.0",
  "exports": "./main.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env main.ts",
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --watch main.ts",
    "check": "deno check main.ts"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4.5.0",
    "@hono/hono/html": "jsr:@hono/hono@^4.5.0/html",
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
